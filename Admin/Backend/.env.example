# Local development (Node). On Cloudflare Workers these come from wrangler.jsonc vars + `wrangler secret put`.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8081
# Supabase Postgres (Session pooler URI). Secret — never commit the real value.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=no-verify
DATABASE_POOL_MAX=8
SUPABASE_URL=https://YOUR_REF.supabase.co
# Secret key (sb_secret_…) — backend only, never in a frontend or in git.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
